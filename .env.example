# Copia este fichero como .env y rellena solo lo que necesites.
# Las fuentes que requieren clave se desactivan solas si la clave falta.
# NUNCA subas el .env a git (ya está en .gitignore).

# --- General
# OSINT_DATA_DIR=C:\Users\tu_usuario\osint-datos   # por defecto: carpeta de datos del usuario
# OSINT_LOG_LEVEL=WARNING                           # DEBUG | INFO | WARNING | ERROR
# OSINT_CASE_RETENTION_DAYS=90                      # para `osint caso purgar`
# OSINT_INCLUDE_SENSITIVE=false                     # fuentes con datos penales / categorías especiales
# OSINT_DISABLED_SOURCES=ddg,mojeek                 # lista separada por comas
# OSINT_ENABLED_SOURCES=ine                         # si se indica, SOLO estas

# --- Red
# OSINT_TIMEOUT=20
# OSINT_MAX_RETRIES=3
# OSINT_PER_DOMAIN_INTERVAL=1.0                     # segundos entre peticiones al mismo dominio
# OSINT_PROXY=socks5://127.0.0.1:1080
# OSINT_TOR_PROXY=socks5://127.0.0.1:9050          # solo para direcciones .onion
# OSINT_CACHE_TTL=86400

# --- Claves de API (todas opcionales)
OSINT_HIBP_API_KEY=
OSINT_EMAILREP_API_KEY=
OSINT_BRAVE_API_KEY=
OSINT_GOOGLE_CSE_KEY=
OSINT_GOOGLE_CSE_CX=
OSINT_MOJEEK_API_KEY=
OSINT_YOUTUBE_API_KEY=
OSINT_FACTCHECK_API_KEY=
OSINT_SHODAN_API_KEY=
OSINT_CENSYS_API_ID=
OSINT_CENSYS_API_SECRET=
OSINT_INTELX_API_KEY=
OSINT_LIBREBOR_API_KEY=
OSINT_IPINFO_TOKEN=
