# Copia este fichero como .env y rellena solo lo que necesites.
# Las fuentes que requieren clave se desactivan solas si la clave falta.
# NUNCA subas el .env a git (ya está en .gitignore).

# --- General
# DANTERODIA_DATA_DIR=C:\Users\tu_usuario\osint-datos   # por defecto: carpeta de datos del usuario
# DANTERODIA_LOG_LEVEL=WARNING                           # DEBUG | INFO | WARNING | ERROR
# DANTERODIA_CASE_RETENTION_DAYS=90                      # para `danterodia caso purgar`
# DANTERODIA_INCLUDE_SENSITIVE=false                     # fuentes con datos penales / categorías especiales
# DANTERODIA_DISABLED_SOURCES=buscadores,prensa          # lista separada por comas
# DANTERODIA_ENABLED_SOURCES=ine                         # si se indica, SOLO estas

# --- Red
# DANTERODIA_TIMEOUT=20
# DANTERODIA_MAX_RETRIES=3
# DANTERODIA_PER_DOMAIN_INTERVAL=1.0                     # segundos entre peticiones al mismo dominio
# DANTERODIA_PROXY=socks5://127.0.0.1:1080
# DANTERODIA_TOR_PROXY=socks5://127.0.0.1:9050          # solo para direcciones .onion
# DANTERODIA_CACHE_TTL=86400

# --- Claves de API (todas opcionales)
DANTERODIA_HIBP_API_KEY=
DANTERODIA_EMAILREP_API_KEY=
DANTERODIA_BRAVE_API_KEY=
DANTERODIA_GOOGLE_CSE_KEY=
DANTERODIA_GOOGLE_CSE_CX=
DANTERODIA_MOJEEK_API_KEY=
DANTERODIA_YOUTUBE_API_KEY=
DANTERODIA_FACTCHECK_API_KEY=
DANTERODIA_SHODAN_API_KEY=
DANTERODIA_CENSYS_API_ID=
DANTERODIA_CENSYS_API_SECRET=
DANTERODIA_INTELX_API_KEY=
DANTERODIA_LIBREBOR_API_KEY=
DANTERODIA_IPINFO_TOKEN=
