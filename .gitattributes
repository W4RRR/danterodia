# Normaliza finales de línea: LF en el repositorio, nativo en la copia de trabajo
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.pdf binary
*.PDF binary
*.rar binary
*.png binary
*.jpg binary
Dockerfile text eol=lf
.dockerignore text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.lock text eol=lf
